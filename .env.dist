# Default configuration. Override locally in .env.local (not committed).

APP_ENV=dev
APP_SECRET=change_me_to_a_random_string

# SQLite by default (same as the Django project). For MySQL/PostgreSQL, e.g.:
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/secure_storage?serverVersion=8.0&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# JWT keys: generate with `php bin/console lexik:jwt:generate-keypair`
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me

# Uploaded files are stored here, outside the public web root.
STORAGE_DIR=%kernel.project_dir%/var/storage

# ClamAV daemon (clamd) TCP socket
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Background virus re-scan (replaces Celery). "sync://" runs it inline.
# For a real queue: composer require symfony/redis-messenger, then
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages and run `php bin/console messenger:consume async`
MESSENGER_TRANSPORT_DSN=sync://

# Comma-separated list of reverse proxy IPs/CIDRs whose X-Forwarded-For header is trusted
TRUSTED_PROXIES=
